# syntax=docker/dockerfile:1.7
# Build with --build-context stlc_wheels=./wheelhouse. Only approved wheels
# matching requirements.azure.txt are used; private registry credentials are absent.
FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash bubblewrap ca-certificates curl git jq ripgrep build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
WORKDIR /app
COPY src/requirements.azure.txt /app/requirements.azure.txt
RUN --mount=type=bind,from=stlc_wheels,target=/opt/wheels \
    PIP_CONFIG_FILE=/dev/null python -m pip install --no-cache-dir \
    --index-url https://pypi.org/simple --find-links /opt/wheels \
    --require-hashes -r /app/requirements.azure.txt \
    && python -m pip check
COPY src /app/src
RUN useradd --create-home --uid 10001 appuser && mkdir -p /app/workspace \
    && chown appuser:appuser /app/workspace
ENV ET_AI_STLC_WORKSPACE=/app/workspace
USER appuser

FROM runtime AS managed_runtime
USER root
COPY deployment/azure/playwright/package*.json /opt/stlc-playwright/
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN npm ci --prefix /opt/stlc-playwright --ignore-scripts --no-audit --no-fund \
    && node /opt/stlc-playwright/node_modules/playwright/cli.js install --with-deps chromium \
    && chmod -R a+rX /opt/ms-playwright /opt/stlc-playwright \
    && ln -s /opt/stlc-playwright/node_modules/playwright/cli.js /usr/local/bin/playwright \
    && rm -rf /var/lib/apt/lists/* /root/.npm
COPY deployment/azure/runtime_bootstrap.py /usr/local/lib/stlc-runtime-bootstrap.py
# Foundry mounts a root-owned session home after the image is built. Initialize
# that mount, then permanently drop to UID/GID 10001 before starting any runtime.
ENV HOME=/home/appuser PYTHONNOUSERSITE=1
CMD ["python", "-I", "/usr/local/lib/stlc-runtime-bootstrap.py"]

FROM runtime AS webhook
CMD ["python", "-m", "src.api"]
